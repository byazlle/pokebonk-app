<?xml version="1.0" encoding="utf-8"?>
<!-- 手柄版启动菜单：进入游戏 / 映射按键设置 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#141420"
    android:keepScreenOn="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="POKEBONK"
        android:textColor="#F5D442"
        android:textSize="44sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="手柄版 · 支持 Xbox 手柄"
        android:textColor="#9A9AB0"
        android:textSize="15sp"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/btn_play"
        android:layout_width="280dp"
        android:layout_height="62dp"
        android:layout_marginTop="42dp"
        android:text="▶  进入游戏"
        android:textSize="19sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E8463A" />

    <Button
        android:id="@+id/btn_mapping"
        android:layout_width="280dp"
        android:layout_height="62dp"
        android:layout_marginTop="18dp"
        android:text="🎮  映射按键设置"
        android:textSize="19sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3D3D8F" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="提示：连接 Xbox 手柄后进入游戏即可操作\n点按映射行改手柄按键，长按改目标键"
        android:textColor="#6E6E86"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="34dp" />
</LinearLayout>
