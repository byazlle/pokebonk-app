<?xml version="1.0" encoding="utf-8"?>
<!-- 映射表格行：功能 / 手柄按键 / 目标键 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/col_func"
        android:layout_width="0dp" android:layout_weight="1.6"
        android:layout_height="wrap_content"
        android:textColor="#222222" android:textSize="15sp"/>

    <TextView
        android:id="@+id/col_button"
        android:layout_width="0dp" android:layout_weight="1.2"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#E8463A" android:textStyle="bold" android:textSize="15sp"
        android:background="#FDEEEC"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"/>

    <TextView
        android:id="@+id/col_target"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#3D3D8F" android:textStyle="bold" android:textSize="15sp"/>
</LinearLayout>
