{
  "name": "pokebonk",
  "productName": "Pokebonk",
  "version": "0.2.0",
  "description": "Pokebonk 电脑手柄版：Chromium 桌面封装，Xbox 手柄映射 + Ins 键设置菜单",
  "main": "main.js",
  "author": "byazlle",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build-installer": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.pokebonk.app.pc",
    "productName": "Pokebonk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "wrapper.html",
      "renderer.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pokebonk",
      "artifactName": "Pokebonk-0.2-pc-win64-setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  }
}
